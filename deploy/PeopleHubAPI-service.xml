<service>
  <id>PeopleHubAPI</id>
  <name>PeopleHub API Server</name>
  <description>PeopleHub Go Backend API Server</description>
  <executable>G:\softwer\People-hub\peoplehub.exe</executable>
  <workingdirectory>G:\softwer\People-hub</workingdirectory>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec"/>
  <delayedAutoStart>true</delayedAutoStart>
  <startmode>Automatic</startmode>
  <env name="API_PORT" value="5050"/>
  <env name="DB_HOST" value="localhost"/>
  <env name="DB_PORT" value="5432"/>
  <env name="DB_USER" value="shakil"/>
  <env name="DB_PASS" value="123456"/>
  <env name="DB_NAME" value="peoplehub"/>
  <env name="DB_SSLMODE" value="disable"/>
  <env name="JWT_SECRET" value="f07399afa90bb3d45a5fe300456ebb8d2abad73f51fcaad73e30f723c8cdcbb0"/>
  <!-- GO_ENV removed for local dev: production requires DB_PASS>=12 and JWT>=32; DB still uses 123456 -->
  <!-- To run as production, set strong DB_PASS in postgres AND here, then set GO_ENV=production -->
  <prestart-command>powershell -Command "if (-not (Test-Path 'G:\softwer\People-hub\uploads')) { New-Item -ItemType Directory -Path 'G:\softwer\People-hub\uploads' -Force }"</prestart-command>
</service>

